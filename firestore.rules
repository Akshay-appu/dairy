rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to verify ownership (requesting user ID matches document userId)
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Helper function to check if account deletion is NOT in progress for this user
    function notDeleting(userId) {
      return !exists(/databases/$(database)/documents/users/$(userId)/meta/deletionInProgress);
    }

    // Comprehensive rules for all user data trees under /users/{userId}/**
    match /users/{userId}/{document=**} {
      // Reads and deletes are always allowed for the owner
      allow read, delete: if isOwner(userId);

      // Creates and updates require ownership and that no account deletion is locked
      allow create, update: if isOwner(userId) && notDeleting(userId);
    }

    // Explicit workspace isolation rules matching our multi-workspace schema
    match /users/{userId}/workspaces/{workspaceId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && notDeleting(userId);

      match /{collection}/{documentId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && notDeleting(userId);
      }

      match /meta/{metaDoc} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && notDeleting(userId);
      }
    }
  }
}
